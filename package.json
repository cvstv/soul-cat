{
  "name": "soul-cat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "refresh": "tsx --env-file-if-exists=.env server/refresh-cli.ts",
    "start": "npm run api",
    "audit:production": "npm audit --omit=dev",
    "api": "tsx --env-file-if-exists=.env server/local.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@netlify/functions": "6.0.0",
    "cheerio": "1.2.0",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
